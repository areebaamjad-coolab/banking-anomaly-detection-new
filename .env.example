# Paths
DATABASE_DIR=data/database
DATABASE_CSV=transactions_master.csv
OUTPUT_DIR=data/outputs
MODEL_DIR=data/processed/models

# Train/test partition (by account_id)
TRAIN_RATIO=0.8
RANDOM_STATE=42

# Z-score output thresholds 
Z_THRESHOLD="±3.5"
Z_THRESHOLD_TIERS="±3.0,±4.0,±5.0"

# Isolation Forest grid
IF_CONTAMINATION=0.001,0.002,0.003,0.005,0.010
IF_N_ESTIMATORS=100,300,500
IF_MAX_FEATURES=0.6,0.8,1.0
IF_MAX_SAMPLES=auto

# LOF
LOF_N_NEIGHBORS=20
LOF_CONTAMINATION=0.005

# Autoencoder
AE_EPOCHS=50
AE_BATCH_SIZE=256
AE_ENCODING_DIM=32
AE_LEARNING_RATE=0.001
